---
import { projects } from "@/data/projects";
import { platformProjects } from "@/data/open-source";
import { site } from "@/data/site";
import { ledger, ledgerStats, formatLedgerYears, badgeFor } from "@/data/ledger";

const nicegram = platformProjects.find((p) => p.slug === "nicegram");
---

<section class="section" id="projects">
  <div class="page">
    <p class="section-index reveal">
      <span class="num">03</span>
      <span>Projects</span>
    </p>

    <div class="head reveal">
      <h2>What's running.</h2>
      <p>
        Three products in production under
        {" "}<a href={site.lab.url}>{site.lab.name}</a>, the lab I ship through.
        I write the code and run the business behind each one.
      </p>
    </div>

    <ul class="live">
      {projects.map((p) => (
        <li class="product reveal">
          <div class="product-head">
            <a class="product-name" href={p.url} target="_blank" rel="noopener noreferrer">
              {p.name}
              <span aria-hidden="true">↗</span>
            </a>
            <span class="chip-live">
              <span class="dot" aria-hidden="true"></span>LIVE
            </span>
          </div>
          <span class="mono product-domain">{p.domain}</span>
          <p class="product-line">{p.tagline}</p>
          <dl class="specs">
            {p.highlights.map((h) => (
              <div class="spec">
                <dd>{h}</dd>
              </div>
            ))}
          </dl>
          <div class="stack">
            {p.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
        </li>
      ))}
    </ul>

    {nicegram && (
      <article class="spotlight reveal">
        <div class="spotlight-metric">
          <span class="metric-val">{nicegram.metric}</span>
          <span class="mono">{nicegram.metricLabel}</span>
        </div>
        <div>
          <div class="spotlight-title">
            <a href={nicegram.href} target="_blank" rel="noopener noreferrer">
              {nicegram.name}
              <span aria-hidden="true">↗</span>
            </a>
            <span class="chip-kind">{nicegram.badge}</span>
          </div>
          <p class="spotlight-blurb">{nicegram.blurb}</p>
          <div class="spotlight-links">
            <span class="mono">{nicegram.role}</span>
            {nicegram.links.map((l) => (
              <a class="tag" href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}
              </a>
            ))}
          </div>
        </div>
      </article>
    )}

    <div class="ledger-head reveal">
      <h3>Before and alongside</h3>
      <p class="mono">
        {ledgerStats.total} shipped · {ledgerStats.live} still running ·
        since {site.shippingSince}
      </p>
    </div>

    <ol class="rows" aria-label="Everything shipped">
      {ledger.map((e, i) => {
        const isEarly = e.status === "early-access";
        const isLive = e.yearEnd === "present" && !isEarly;
        const badge = badgeFor(e);
        const Row = e.url ? "a" : "div";
        const rowProps = e.url
          ? {
              href: e.url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "row-inner is-link",
            }
          : { class: "row-inner" };
        return (
          <li class="row reveal">
            <Row {...rowProps}>
              <span class="mono idx">{String(i + 1).padStart(2, "0")}</span>
              <span class="mono years">{formatLedgerYears(e)}</span>
              <div class="body">
                <div class="title-line">
                  <span class="name">{e.name}</span>
                  {e.domain && <span class="mono domain">{e.domain}</span>}
                  {badge && <span class="chip-kind">{badge}</span>}
                  {isEarly && <span class="chip-early">EARLY ACCESS</span>}
                  {isLive && (
                    <span class="chip-live">
                      <span class="dot" aria-hidden="true"></span>LIVE
                    </span>
                  )}
                  {!isLive && !isEarly && (
                    <span class="chip-archived">ARCHIVED</span>
                  )}
                </div>
                <p class="blurb">{e.blurb}</p>
                {e.metric && <p class="metric">{e.metric}</p>}
                <span class="mono role">{e.role}</span>
              </div>
              {e.url && <span class="arrow" aria-hidden="true">↗</span>}
            </Row>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .head {
    margin-top: 1.6rem;
    max-width: 60ch;
  }

  .head h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .head p {
    margin-top: 0.85rem;
    color: var(--ink-muted);
    line-height: 1.65;
  }

  .head a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 60, 255, 0.35);
  }

  /* Live products */
  .live {
    margin-top: 2.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .live {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .product {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.35rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    transition: border-color 200ms ease;
  }

  .product:hover {
    border-color: var(--ink);
  }

  .product-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .product-name {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .product-name:hover {
    color: var(--accent);
  }

  .product-domain {
    text-transform: none;
    letter-spacing: 0.05em;
  }

  .product-line {
    margin-top: 0.35rem;
    font-weight: 500;
    line-height: 1.45;
  }

  /* Specs read as a table of facts rather than a bulleted pitch. */
  .specs {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .spec {
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .spec dd {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .stack {
    margin-top: auto;
    padding-top: 0.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  /* Nicegram spotlight */
  .spotlight {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    padding: 1.5rem;
    border: 1px solid var(--ink);
    border-radius: 0.5rem;
  }

  @media (min-width: 760px) {
    .spotlight {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      gap: 2rem;
      align-items: center;
    }
  }

  .spotlight-metric {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-val {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-feature-settings: "tnum";
  }

  .spotlight-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }

  .spotlight-title a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.2rem;
    font-weight: 600;
    text-decoration: none;
  }

  .spotlight-title a:hover {
    color: var(--accent);
  }

  .spotlight-blurb {
    margin-top: 0.5rem;
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 62ch;
  }

  .spotlight-links {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }

  .spotlight-links a.tag {
    text-decoration: none;
  }

  .spotlight-links a.tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Ledger */
  .ledger-head {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-bottom: 0.75rem;
  }

  .ledger-head h3 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ledger-head p {
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .rows {
    border-top: 1px solid var(--ink);
  }

  .row {
    border-bottom: 1px solid var(--line);
  }

  .row-inner {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: start;
    gap: 1.25rem;
    padding: 1.1rem 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: background 180ms ease;
  }

  .row-inner.is-link:hover {
    background: var(--bg-sub);
  }

  .row-inner.is-link:hover .arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .idx {
    color: var(--ink-subtle);
    min-width: 1.8rem;
    padding-top: 0.2rem;
  }

  .years {
    min-width: 8rem;
    padding-top: 0.2rem;
    color: var(--ink-muted);
    text-transform: none;
    letter-spacing: 0.06em;
    font-feature-settings: "tnum";
  }

  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .title-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .name {
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .domain {
    text-transform: none;
    letter-spacing: 0.05em;
  }

  .blurb {
    color: var(--ink-muted);
    line-height: 1.55;
    font-size: 0.92rem;
    max-width: 68ch;
  }

  .metric {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    font-feature-settings: "tnum";
  }

  .role {
    color: var(--ink-subtle);
  }

  .arrow {
    font-family: var(--font-mono);
    color: var(--ink-subtle);
    padding-top: 0.15rem;
    transition: transform 200ms ease, color 200ms ease;
  }

  @media (max-width: 700px) {
    .row-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "idx arrow"
        "years arrow"
        "body body";
      gap: 0.3rem;
      padding: 1.05rem 0.25rem;
    }

    .idx {
      grid-area: idx;
    }
    .years {
      grid-area: years;
      min-width: 0;
    }
    .body {
      grid-area: body;
      margin-top: 0.35rem;
    }
    .arrow {
      grid-area: arrow;
      align-self: start;
    }
  }
</style>
