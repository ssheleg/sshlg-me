---
import { site, contacts, channels } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="page inner">
    <div class="col brand">
      <span class="name">{site.name}</span>
      <p>
        Technical entrepreneur in Warsaw, Poland. {site.yearsExperience} years of
        shipped products. I build under
        {" "}<a href={site.lab.url}>{site.lab.name}</a>.
      </p>
    </div>

    <nav class="col" aria-label="Sections">
      <span class="mono">Site</span>
      <a href="/#whoami">Whoami</a>
      <a href="/#toolkit">Toolkit</a>
      <a href="/#projects">Projects</a>
      <a href="/#writing">Writing</a>
      <a href="/#contact">Contact</a>
    </nav>

    <nav class="col" aria-label="Elsewhere">
      <span class="mono">Elsewhere</span>
      {contacts.map((c) => (
        <a
          href={c.href}
          {...(c.href.startsWith("http")
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {})}
        >
          {c.label} <span class="muted">{c.handle}</span>
        </a>
      ))}
    </nav>

    <nav class="col" aria-label="Channels">
      <span class="mono">Channels</span>
      {channels.map((c) => (
        <a href={c.href} target="_blank" rel="noopener noreferrer">
          {c.name} <span class="muted">{c.language}</span>
        </a>
      ))}
      <a href={site.lab.consultingUrl} target="_blank" rel="noopener noreferrer">
        Consulting <span class="muted">svlab.online</span>
      </a>
    </nav>
  </div>

  <div class="page legal">
    <span>© {year} {site.name} ({site.nameAlternate}).</span>
    <span class="mono">sshlg.me</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-top: 3rem;
    padding-bottom: 2rem;
    background: var(--bg-sub);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 760px) {
    .inner {
      grid-template-columns: 1.5fr repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .brand {
    max-width: 34ch;
  }

  .brand .name {
    font-weight: 600;
    font-size: 1rem;
  }

  .brand p {
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .brand a {
    color: var(--accent);
    text-decoration: none;
  }

  .col a {
    color: var(--ink);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .col a:hover {
    color: var(--accent);
  }

  .muted {
    color: var(--ink-subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    justify-content: space-between;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--ink-subtle);
    font-size: 0.84rem;
  }
</style>
