---
import { site } from "@/data/site";
import { projects } from "@/data/projects";
import { skillFamily } from "@/data/open-source";
---

<section class="section" id="now">
  <div class="page">
    <p class="section-index reveal">
      <span class="num">02</span>
      <span>Now</span>
    </p>

    <div class="head reveal">
      <h2>What I'm building.</h2>
      <p>
        Everything below runs under <a href={site.lab.url}>{site.lab.name}</a>,
        the lab I ship under. Built, marketed, and operated by me — in
        production, not demos.
      </p>
    </div>

    <ul class="grid">
      {projects.map((p, i) => (
        <li class="card reveal">
          <div class="card-top">
            <span class="mono idx">/{String(i + 1).padStart(2, "0")}</span>
            <span class="chip-live">
              <span class="dot" aria-hidden="true"></span>LIVE
            </span>
          </div>
          <a class="card-name" href={p.url} target="_blank" rel="noopener noreferrer">
            {p.name}
            <span aria-hidden="true">↗</span>
          </a>
          <span class="mono domain">{p.domain}</span>
          <p class="card-tagline">{p.tagline}</p>
          <ul class="highlights">
            {p.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          <div class="stack">
            {p.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
        </li>
      ))}
    </ul>

    <div class="oss reveal">
      <div class="oss-head">
        <h3>{skillFamily.name}</h3>
        <span class="chip-kind">{skillFamily.license}</span>
        <span class="mono">{skillFamily.skills.length} skills · {skillFamily.agents.length}+ agents</span>
      </div>
      <p class="oss-blurb">{skillFamily.blurb}</p>
      <div class="install">
        <code>
          <span class="term-user">$</span>
          {skillFamily.install}
        </code>
        <a class="oss-link" href={skillFamily.repo} target="_blank" rel="noopener noreferrer">
          Repo
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ul class="skills">
        {skillFamily.skills.map((s) => (
          <li>
            <a href={s.repo} target="_blank" rel="noopener noreferrer">
              {s.name}
              {s.isNew && <span class="new">NEW</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .head {
    margin-top: 1.6rem;
    max-width: 62ch;
  }

  .head h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .head p {
    margin-top: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.65;
  }

  .head a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 60, 255, 0.35);
  }

  .grid {
    margin-top: 2.25rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--bg);
    transition: border-color 200ms ease;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .idx {
    color: var(--ink-subtle);
  }

  .card-name {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .card-name:hover {
    color: var(--accent);
  }

  .domain {
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .card-tagline {
    margin-top: 0.2rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .highlights {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .highlights li {
    padding-left: 1rem;
    position: relative;
  }

  .highlights li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .stack {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    border-top: 1px dashed var(--line);
  }

  /* Skill family */
  .oss {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.6rem;
    background: var(--bg-sub);
  }

  .oss-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 0.9rem;
  }

  .oss-head h3 {
    font-family: var(--font-mono);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .oss-blurb {
    margin-top: 0.7rem;
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 68ch;
  }

  .install {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.4rem;
    background: var(--bg);
  }

  .install code {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .install code::-webkit-scrollbar {
    display: none;
  }

  .install .term-user {
    color: var(--accent);
    margin-right: 0.6ch;
  }

  .oss-link {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .skills {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skills a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.3rem;
    background: var(--bg);
    text-decoration: none;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .skills a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .new {
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    padding: 0.05rem 0.3rem;
    border-radius: 0.2rem;
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>
