---
import { site, contacts } from "@/data/site";
---

<section class="section" id="contact">
  <div class="page">
    <p class="section-index reveal">
      <span class="num">05</span>
      <span>Contact</span>
    </p>

    <div class="head reveal">
      <h2>Get in touch.</h2>
      <p>
        Building something, hiring an outside operator, or want an agent setup
        that produces code you can maintain — write to me directly. For
        consulting engagements, the details live on
        {" "}<a href={site.lab.consultingUrl}>{site.lab.name}</a>.
      </p>
    </div>

    <ul class="rows">
      {contacts.map((c) => (
        <li class="reveal">
          <a
            class:list={["row", { "is-primary": c.primary }]}
            href={c.href}
            {...(c.href.startsWith("http")
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <span class="mono label">{c.label}</span>
            <span class="handle">{c.handle}</span>
            <span class="note">{c.note}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head {
    margin-top: 1.6rem;
    max-width: 62ch;
  }

  .head h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 600;
  }

  .head p {
    margin-top: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.65;
  }

  .head a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 60, 255, 0.35);
  }

  .rows {
    margin-top: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .rows li {
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 14rem) 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0.75rem;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .row:hover {
    background: var(--bg-sub);
    border-left-color: var(--accent);
  }

  .row:hover .arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .label {
    color: var(--ink-subtle);
  }

  .handle {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
  }

  .row.is-primary .handle {
    color: var(--accent);
  }

  .note {
    color: var(--ink-muted);
    font-size: 0.92rem;
  }

  .arrow {
    font-family: var(--font-mono);
    color: var(--ink-subtle);
    transition: transform 200ms ease, color 200ms ease;
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "label arrow"
        "handle arrow"
        "note note";
      gap: 0.3rem;
      padding: 1.1rem 0.25rem;
    }

    .label {
      grid-area: label;
    }
    .handle {
      grid-area: handle;
    }
    .note {
      grid-area: note;
      margin-top: 0.35rem;
    }
    .arrow {
      grid-area: arrow;
      align-self: center;
    }
  }
</style>
