---
import { site } from "@/data/site";
import { ledgerStats } from "@/data/ledger";

const strip = [
  { label: "Years", value: `${ledgerStats.years}+ shipping` },
  { label: "Shipped", value: `${ledgerStats.total} products` },
  { label: "Live", value: `${ledgerStats.live} running` },
  { label: "Base", value: "Warsaw, PL" },
];
---

<section class="hero" id="whoami">
  <div class="page">
    <p class="section-index">
      <span class="num">01</span>
      <span>Whoami</span>
    </p>

    <div class="split">
      <div class="copy">
        <p class="term prompt">
          <span class="term-user">sshlg@me</span>
          <span>~</span>
          <span>%</span>
          <span class="term-cmd">whoami</span>
          <span class="caret" aria-hidden="true"></span>
        </p>

        <h1 class="name">{site.name}</h1>
        <p class="role mono">{site.role}</p>

        <p class="lede">
          Technical entrepreneur in Warsaw, Poland. {ledgerStats.years} years
          building and launching products used by
          <strong>millions of people</strong> — mobile, desktop, web. I stay in
          the technical work: <strong>AI integrations and agent systems</strong>,
          marketing and research tooling, growth and retention, go-to-market.
        </p>

        <ul class="expertise" aria-label="Areas of expertise">
          {site.expertise.map((item) => <li class="tag">{item}</li>)}
        </ul>

        <div class="actions">
          <a class="btn btn-primary" href="/#projects">
            ls ./projects
            <span aria-hidden="true">↓</span>
          </a>
          <a class="btn btn-secondary" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </div>
      </div>

      <figure class="portrait">
        <img
          src="/portrait.jpg"
          alt={`${site.name} — illustrated portrait`}
          width="800"
          height="800"
          loading="eager"
          decoding="sync"
        />
      </figure>
    </div>

    <dl class="strip">
      {strip.map((cell) => (
        <div class="cell">
          <dt class="mono">{cell.label}</dt>
          <dd class="cell-val">{cell.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(3.5rem, 9vw, 6rem);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* The portrait only earns its column when there's room for the lede to keep
     a readable measure beside it. */
  @media (min-width: 1000px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: 3rem;
      align-items: center;
    }
  }

  .portrait {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: 0.5rem;
    overflow: hidden;
    background: #000;
    line-height: 0;
    max-width: 22rem;
  }

  .portrait img {
    width: 100%;
    height: auto;
  }

  .prompt {
    margin-top: 1.5rem;
  }

  .name {
    margin-top: 1.1rem;
    font-size: clamp(2.8rem, 8vw, 6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 600;
  }

  .role {
    margin-top: 0.85rem;
    color: var(--accent);
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 62ch;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
  }

  .lede strong {
    color: var(--ink);
    font-weight: 500;
  }

  .expertise {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    max-width: 66ch;
  }

  .expertise .tag {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    padding: 0.3rem 0.6rem;
  }

  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .strip {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cell-val {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    font-feature-settings: "tnum";
  }
</style>
